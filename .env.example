# JumpPark — API pública (somente leitura)
# Documentação: https://docs.jumpparkapi.com.br/public/
JUMPPARK_API_BASE_URL=
JUMPPARK_API_TOKEN=
JUMPPARK_API_USER_ID=
JUMPPARK_ESTABLISHMENT_ID=
# Origem autorizada no painel JumpPark (usada em Origin/Referer). Opcional.
JUMPPARK_API_ORIGIN=

# Banco de dados (Postgres — Vercel Postgres ou Neon). Ausente = app usa armazenamento em
# memória, não persistente (ver docs/database-and-auth-setup-guide.md).
DATABASE_URL=

# Banco de teste (opcional, só usado quando NODE_ENV=test). Em teste, DATABASE_URL é SEMPRE
# ignorada — nunca use a mesma connection string de produção aqui. Ausente = testes usam
# armazenamento em memória (o padrão do dia a dia). Ver docs/database-and-auth-setup-guide.md,
# seção "Como rodar os testes com segurança".
TEST_DATABASE_URL=

# Gate de acesso temporário (middleware.ts) — desativado por padrão. Só ative depois de definir
# usuário/senha fortes. Nunca versione valores reais aqui. Ver
# docs/database-and-auth-setup-guide.md, seção "Como ativar o gate temporário".
APP_ACCESS_ENABLED=
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=

# Integrações futuras (não utilizadas nesta fase)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=

STONE_API_KEY=
STONE_ACCOUNT_ID=

# WhatsApp Cloud API oficial da Meta (Missão Z6.2) — WHATSAPP_ENABLED precisa ser "true" E todas
# as credenciais abaixo precisarem estar presentes para o canal sair do modo desabilitado (fail
# closed por padrão, ver src/lib/integrations/whatsapp/config.ts). Nunca "true" em produção
# enquanto a Meta Business/número não estiverem realmente configurados.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

CAMERAS_BRIDGE_URL=
CAMERAS_BRIDGE_TOKEN=
